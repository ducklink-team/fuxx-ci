{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dipendenze FUXX settimanali; merge affidato alla CI e alla revisione AI",
  "extends": ["config:recommended"],
  "timezone": "Europe/Rome",
  "schedule": ["before 6am on monday"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "labels": ["dipendenze"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "groupName": "dipendenze compatibili" },
    { "matchUpdateTypes": ["major"], "labels": ["dipendenze", "serve-ok"] }
  ]
}
